   "source": [
    "eos_id = tokenizer.token_to_id(\"<eos>\")\n",
    "ids = tokenizer.encode(\"Hello world.<eos>\").ids\n",
    "\n",
    "assert eos_id is not None, \"<eos> must exist in vocabulary\"\n",
    "assert ids.count(eos_id) == 1, \"<eos> should encode to exactly one token\"\n",
    "\n",
    "sample = \"Hello, world! café 你好 🙂\"\n",
    "decoded = tokenizer.decode(tokenizer.encode(sample).ids)\n",
    "\n",
    "print(\"Special token ids:\", {t: tokenizer.token_to_id(t) for t in SPECIAL_TOKENS})\n",
    "print(\"Round trip OK:\", decoded == sample)"
   ]
