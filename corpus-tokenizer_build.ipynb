   "source": [
    "import random\n",
    "from pathlib import Path\n",
    "from datasets import load_dataset\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "OUT_DIR = Path(\"/kaggle/working/corpus\")\n",
    "\n",
    "SEED = 42\n",
    "MIN_CHARS = 200\n",
    "SHUFFLE_BUFFER = 100_000\n",
    "\n",
    "GB = 1024 ** 3\n",
    "EOT = \"\\n<eos>\\n\"\n",
    "\n",
    "sources = {\n",
    "    \"fineweb_edu\": (5.0, \"HuggingFaceFW/fineweb-edu\", \"sample-10BT\"),\n",
    "    \"dclm\": (3.0, \"mlfoundations/dclm-baseline-1.0-parquet\", None),\n",
    "    \"cosmopedia_v2\": (3.0, \"HuggingFaceTB/smollm-corpus\", \"cosmopedia-v2\"),\n",
    "    \"bookcorpus\": (3.0, \"rojagtap/bookcorpus\", None),\n",
    "    \"wikipedia\": (2.0, \"wikimedia/wikipedia\", \"20231101.en\"),\n",
    "}\n",
    "\n",
    "def stream_dataset(repo, config=None):\n",
    "    ds = load_dataset(repo, config, split=\"train\", streaming=True)\n",
    "    ds = ds.shuffle(seed=SEED, buffer_size=SHUFFLE_BUFFER)\n",
    "\n",
    "    for row in ds:\n",
    "        text = row.get(\"text\")\n",
    "        if text:\n",
    "            yield text\n",
    "\n",
    "def build_dataset(name, size_gb, repo, config=None):\n",
    "    output = OUT_DIR / f\"{name}.txt\"\n",
    "    if output.exists():\n",
    "        print(f\"{name} already exists\")\n",
    "        return\n",
    "\n",
    "    target = int(size_gb * GB)\n",
    "    written = 0\n",
    "    print(f\"\\n{name} target: {size_gb:.1f} GB\")\n",
    "    stream = stream_dataset(repo, config)\n",
    "\n",
    "    with open(output, \"wb\") as f:\n",
    "        with tqdm(total=target, unit=\"B\", unit_scale=True, desc=name) as pbar:\n",
    "            for text in stream:\n",
    "                text = text.strip()\n",
    "                if len(text) < MIN_CHARS:\n",
    "                    continue\n",
    "\n",
    "                text = text.replace(\"\\x00\", \" \").replace(\"<eos>\", \"\")\n",
    "                if len(text) < MIN_CHARS:\n",
    "                    continue\n",
    "\n",
    "                data = (text + EOT).encode(\"utf-8\")\n",
    "                f.write(data)\n",
    "\n",
    "                written += len(data)\n",
    "                pbar.update(len(data))\n",
    "                if written >= target:\n",
    "                    break\n",
    "\n",
    "    if written == 0:\n",
    "        output.unlink(missing_ok=True)\n",
    "        raise RuntimeError(\"No usable text was found.\")\n",
    "    print(f\"{name}: {written / GB:.2f} GB\")\n",
    "\n",
    "OUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "for name, (size, repo, config) in sources.items():\n",
    "    try:\n",
    "        build_dataset(name, size, repo, config)\n",
    "    except Exception as e:\n",
    "        print(f\"{name} failed: {e}\")\n",
    "\n",
    "print(\"\\nCorpus size:\")\n",
    "total = 0\n",
    "\n",
    "for name in sources:\n",
    "    file = OUT_DIR / f\"{name}.txt\"\n",
    "    if file.exists():\n",
    "        size = file.stat().st_size / GB\n",
    "        total += size\n",
    "        print(f\"{name:<20} {size:.2f} GB\")\n",
    "\n",
    "print(f\"{'Total':<20} {total:.2f} GB\")"
   ]
