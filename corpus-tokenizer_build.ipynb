   "source": [
    "from tokenizers import Tokenizer\n",
    "from tokenizers.models import BPE\n",
    "from tokenizers.trainers import BpeTrainer\n",
    "from tokenizers.pre_tokenizers import ByteLevel\n",
    "from tokenizers.decoders import ByteLevel as ByteLevelDecoder\n",
    "\n",
    "CORPUS_DIR = Path(\"/kaggle/working/corpus\")\n",
    "TOKENIZER_PATH = \"/kaggle/working/tokenizer.json\"\n",
    "\n",
    "SAMPLE_RATIO = 0.25  # ~4 GB of a 16 GB corpus\n",
    "VOCAB_SIZE = 34_000\n",
    "MIN_FREQUENCY = 2\n",
    "SEED = 42\n",
    "EOT = \"\\n<eos>\\n\"\n",
    "CHUNK_CHARS = 1 << 24 \n",
    "\n",
    "SPECIAL_TOKENS = [\"<pad>\", \"<unk>\", \"<bos>\", \"<eos>\"]\n",
    "\n",
    "files = sorted(CORPUS_DIR.glob(\"*.txt\"))\n",
    "\n",
    "def iter_docs(path):\n",
    "    \"\"\"Yield documents split on EOT, reading in fixed-size chunks.\"\"\"\n",
    "    tail = \"\"\n",
    "\n",
    "    with open(path, \"r\", encoding=\"utf-8\", newline=\"\") as f:\n",
    "        while True:\n",
    "            chunk = f.read(CHUNK_CHARS)\n",
    "            if not chunk:\n",
    "                break\n",
    "            tail += chunk\n",
    "            parts = tail.split(EOT)\n",
    "            tail = parts.pop()\n",
    "            \n",
    "            yield from parts\n",
    "\n",
    "    if tail.strip():\n",
    "        yield tail\n",
    "\n",
    "def text_stream():\n",
    "    for file in files:\n",
    "        rng = random.Random(f\"{SEED}-{file.name}\")\n",
    "        kept = total = 0  \n",
    "        print(f\"Sampling {SAMPLE_RATIO:.1%} of documents from {file.name}\")\n",
    "\n",
    "        for doc in iter_docs(file):\n",
    "            total += 1\n",
    "            if rng.random() < SAMPLE_RATIO:\n",
    "                kept += 1\n",
    "                yield doc.replace(\"\\x00\", \" \").replace(\"<eos>\", \"\")\n",
    "        print(f\"  kept {kept:,} of {total:,} documents\")\n",
    "\n",
    "tokenizer = Tokenizer(BPE(unk_token=\"<unk>\"))\n",
    "tokenizer.pre_tokenizer = ByteLevel(add_prefix_space=False)\n",
    "tokenizer.decoder = ByteLevelDecoder()\n",
    "\n",
    "trainer = BpeTrainer(\n",
    "    vocab_size=VOCAB_SIZE,\n",
    "    min_frequency=MIN_FREQUENCY,\n",
    "    initial_alphabet=ByteLevel.alphabet(),\n",
    "    special_tokens=SPECIAL_TOKENS,\n",
    ")\n",
    "\n",
    "tokenizer.train_from_iterator(text_stream(), trainer=trainer)\n",
    "tokenizer.save(TOKENIZER_PATH)\n",
    "\n",
    "print(\"\\nTokenizer saved to:\", TOKENIZER_PATH)\n",
    "print(f\"Vocabulary size: {tokenizer.get_vocab_size()}\")"
   ]
  },
